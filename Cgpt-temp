        "tools_required": 1,
        "generate_prompt_key": None,
    }

    out = await agent.execute_tools(state=state, session_name="s")
    assert out["next_step"] in ("GENERATE", "generate")

    # Must be set (your KeyError fix)
    assert out.get("generate_prompt_key")

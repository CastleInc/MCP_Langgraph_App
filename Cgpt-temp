from typing import Literal, Optional
from pydantic import BaseModel, Field
from cstgenai_common_entities.model import RETRIEVE, AGENT_WITH_TOOLS, PDF_EXTRACT_INFO, GENERATE

DatasourceType = Literal[RETRIEVE, GENERATE, AGENT_WITH_TOOLS, PDF_EXTRACT_INFO]

class RouteQuery(BaseModel):
    """
    Route a user query to the most relevant datasource,
    and (optionally) split mixed-intent questions into tool_part + generate_part.
    """
    datasource: DatasourceType = Field(
        description="First step to run. If tool_part exists choose AGENT_WITH_TOOLS."
    )
    tools_needed: int = 0

    # NEW: split fields
    tool_part: Optional[str] = Field(
        default=None,
        description="ONLY the sub-question(s) that require tools. Empty/null if none."
    )
    generate_part: Optional[str] = Field(
        default=None,
        description="ONLY the sub-question(s) that can be answered by the LLM directly. Empty/null if none."
    )


system = f"""
You are an expert at routing and splitting a user question.

You MUST return STRICT JSON ONLY (no markdown, no extra text) matching this schema:
{{
  "datasource": "{RETRIEVE}|{GENERATE}|{AGENT_WITH_TOOLS}|{PDF_EXTRACT_INFO}",
  "tools_needed": 0,
  "tool_part": null,
  "generate_part": null
}}

Available tools:
[
{tools_description}
]

Rules:
1) If ANY part of the question needs tools, set datasource = "{AGENT_WITH_TOOLS}".
   Put ONLY the tool-requiring part into "tool_part".
2) If the question ALSO contains a direct/general question (e.g. "capital of Ireland"),
   put ONLY that part into "generate_part".
3) If nothing needs tools:
   - Use "{GENERATE}" if it’s general knowledge.
   - Use "{RETRIEVE}" if it requires searching internal docs/KB.
4) "tools_needed" should be the number of tool calls you expect (0 if none).
5) Keep tool_part and generate_part short, clean, and user-readable.
"""
from langchain_core.messages import HumanMessage
from langchain.output_parsers import PydanticOutputParser
from cstgenai_common_entities.model import END, GENERATE, AGENT_WITH_TOOLS

async def route_question(state: GraphState) -> GraphState:
    logger.info(msg="Graph State: %s", state)

    # if already ended, keep it
    if state.get("next_step") == END:
        return state

    question_router = await init_question_router(state)

    question = state["question"]
    response = question_router.invoke({"question": question})
    logger.info("Response from Question Router: %s", response)

    output_parser = PydanticOutputParser(pydantic_object=RouteQuery)
    source: RouteQuery = await output_parser.ainvoke(response)
    logger.info("Router parsed: %s", source)

    # --- store routing plan in state ---
    state["tools_required"] = source.tools_needed or 0
    state["pending_generate_part"] = (source.generate_part or "").strip() or None
    state["tool_part"] = (source.tool_part or "").strip() or None

    # Decide first hop
    next_step = source.datasource

    # If we have tool_part, ALWAYS go to tools first
    if state["tool_part"]:
        next_step = AGENT_WITH_TOOLS

        # Make tool agent see only tool_part as the latest user input
        state["question"] = state["tool_part"]
        state.setdefault("messages", [])
        state["messages"].append(HumanMessage(content=state["tool_part"]))

    else:
        # no tools needed
        state["question"] = question  # keep original
        # If router says GENERATE, set a safe default prompt key
        if next_step == GENERATE:
            state.setdefault("generate_prompt_key", "DEFAULT_PROMPT")

    state["next_step"] = next_step
    return state



from langchain_core.messages import HumanMessage
from cstgenai_common_entities.model import GENERATE, AGGREGATE

pending = state.get("pending_generate_part")

if pending:
    state.setdefault("messages", [])
    state["messages"].append(HumanMessage(content=pending))
    state["question"] = pending

    # pick the right prompt key for direct/general question answering
    state["generate_prompt_key"] = state.get("generate_prompt_key") or "DEFAULT_PROMPT"

    state["next_step"] = GENERATE
else:
    # no remaining direct question, go aggregate
    state["next_step"] = AGGREGATE


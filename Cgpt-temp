import logging
import os
from typing import List

from langchain_core.messages import SystemMessage

from cstgenai_rag.model.rag.state import GraphState
from cstgenai_rag.model.rag.models import VectorStoreRequest
from cstgenai_rag.support.db import get_vector_store_retriever

logger = logging.getLogger(__name__)


async def retrieve_vamp(state: GraphState) -> GraphState:
    """
    VAMP Retrieve node.
    Identical to rag_retrieve, but adds a VAMP-specific system prompt.
    No VAMP API calls are made here.
    """

    logger.info("--VAMP VECTOR STORE RETRIEVAL--")

    messages = state["messages"]
    metadata_filter = state.get("metadata_filter", {})
    ai_messages = [msg for msg in messages if hasattr(msg, "type") and msg.type == "ai"]

    # Attach previous AI answer as extra context
    if ai_messages:
        extra_content = ai_messages[-1].content
    else:
        extra_content = ""

    question = state["question"] + "\n" + extra_content
    payload = {"input": question}
    logger.debug(f"Input passed to VAMP Retrieve payload: {payload}")

    documents: List[str] = []
    has_rag_data = False
    generate_prompt_key = "VECTOR_DATA_ABSENT"

    # -------------------------------------------
    # SAME VECTOR STORE RETRIEVAL AS rag_retrieve
    # -------------------------------------------
    reranking_needed = os.getenv("LLM_RERANKING_ENABLED", "true").lower() == "true"

    vector_store_request = VectorStoreRequest(
        base_request=state["knowledgebase_request"],
        filters=metadata_filter,
        ranking_needed=reranking_needed,
    )

    rag_data = await get_vector_store_retriever().get_required_nodes(
        vector_store_request
    )

    if rag_data and rag_data.data:
        documents.append(rag_data.data.context)
        has_rag_data = True
        generate_prompt_key = "VECTOR_DATA_PRESENT"

    # -------------------------------------------
    # NEW: VAMP-SPECIFIC SYSTEM PROMPT
    # -------------------------------------------
    vamp_system_prompt = """
You are a penetration testing assistant with enhanced VAMP intelligence.

Use the user's question, previous assistant response, and vector store context
to generate a highly actionable, testing-focused answer.

You MUST:
- Focus on "what to test" and "how to test" the application.
- Highlight typical patterns pen testers follow in similar assessments.
- Provide step-by-step, actionable recommendations.
- Use vector store context if available.
- DO NOT hallucinate tools or APIs that are not provided.

Do NOT output JSON. Produce a natural-language answer.
""".strip()

    # -------------------------------------------
    # SAME RETURN STRUCTURE AS rag_retrieve
    # -------------------------------------------
    return {
        "documents": documents,
        "messages": [SystemMessage(content=vamp_system_prompt)],
        "next_step": None,  # Allow GENERATE to run after this
        "generate_prompt_key": generate_prompt_key,
        "has_rag_data": has_rag_data,
        "last_stage_data": {
            "rag_data": rag_data.data if rag_data else None
        }
    }


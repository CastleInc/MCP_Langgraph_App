import logging
from typing import Literal, get_args

from pydantic import BaseModel, Field
from langchain_core.prompts import ChatPromptTemplate

from cstgenai_rag.llm.llm_client import get_llm
from cstgenai_rag.model.rag.state import GraphState
from cstgenai_rag.tools.registry import get_tools_for_agent
from langchain.tools.render import render_text_description

logger = logging.getLogger(__name__)

DatasourceType = Literal["RETRIEVE", "AGENT_WITH_TOOLS", "PDF_EXTRACT_INFO"]


class RouteQuery(BaseModel):
    """Route a user query to the most relevant datasource."""

    datasource: DatasourceType = Field(
        description=f"Given a user question choose to route it to one of: "
        f"{', '.join(get_args(DatasourceType))}."
    )
    tools_needed: int = 0

    # NEW: whether we should go into VAMP flow after GENERATE
    vamp_intent: bool = False


async def init_question_router(state: GraphState):
    """
    Build and return the LLM used for routing the user question.

    This is where we define the system prompt that:
    - decides which datasource to use (AGENT_WITH_TOOLS / RETRIEVE / PDF_EXTRACT_INFO)
    - decides how many tools are needed
    - decides whether VAMP should be triggered (vamp_intent)
    """

    llm = get_llm(stream=False)

    # Await your coroutine to get tools
    options = " | ".join(get_args(RouteQuery.model_fields["datasource"].annotation))
    tools = await get_tools_for_agent(state)
    tools_description = render_text_description(tools)

    # JSON skeleton the LLM must fill
    json_template = f"""
{{
  "datasource": "{{datasource}}",
  "options": {options},
  "tools_needed": 1|2|3...,
  "vamp_intent": false
}}
"""

    # ---- System prompt ----
    # NOTE: we prepend the VAMP rule but keep your original rules intact.
    system = f"""
### Additional VAMP Classification Rule (DO NOT MODIFY EXISTING RULES BELOW)
You must determine whether the user's question requires intelligence from
previous AIT assessments (VAMP intelligence).

Set "vamp_intent": true when the question includes any of:
- suggestions on what to test
- recommendations on how to test the application
- "steps followed in their assessment"
- "similar AITs"
- "what did other testers find"
- "give me suggestions"
- anything requiring previous assessment knowledge

Otherwise, set "vamp_intent": false.

You are an expert at routing a user question to {options}.
Decide if a tool from the list of Available tools can fulfill the user's request.

###Available tools:
{tools_description}

###Rules to be followed
1. If any tool/tools can answer; respond {{AGENT_WITH_TOOLS}}, along with the count of tools that are needed.
   Do **NOT** generate any new tool/function names. You can only use tools/function from the list of Available tools.
2. If the question is relating to the testing how to test an AIT or suggestions about how to test the Application(AIT),
   and tools are not sufficient, you may still choose GENERATE as datasource but must set vamp_intent=true.
3. If it requires gathering information from a knowledge base or documents then {{RETRIEVE}}.
4. If user has uploaded a file and is asking questions based on uploaded content then {{PDF_EXTRACT_INFO}}.
5. If you can't decide, use default option of {{RETRIEVE}}.

Be concise and respond only in JSON format as {json_template}.
"""

    route_prompt = ChatPromptTemplate.from_messages(
        [
            ("system", system),
            ("human", "{question}"),
        ]
    )

    question_router = route_prompt | llm
    return question_router




import logging

from langchain_core.output_parsers import PydanticOutputParser
from langgraph.constants import END

from cstgenai_rag.graph.chains.router import RouteQuery, init_question_router
from cstgenai_rag.model.rag.state import GraphState

logger = logging.getLogger(__name__)


async def route_question(state: GraphState) -> GraphState:
    logger.info(msg=f"Graph State: {state}")
    next_step = state.get("next_step")

    # If something upstream already decided to end, respect it
    if next_step and next_step == END:
        return state

    # Build router LLM (uses tools + system prompt)
    question_router = await init_question_router(state)

    logger.info("--ROUTE QUESTION--")
    question = state["question"]
    logger.info(f"Asking question router with question of type {type(question)}")

    # Call router LLM
    response = question_router.invoke({"question": question})

    # Parse into RouteQuery
    output_parser = PydanticOutputParser(pydantic_object=RouteQuery)
    source = await output_parser.ainvoke(response)

    next_step = source.datasource
    tools_needed = source.tools_needed
    vamp_intent = source.vamp_intent

    logger.info(f"Router answered: {source}")

    # Update state
    state["vamp_intent"] = vamp_intent

    return {
        "messages": [response],
        "next_step": next_step,
        "tools_required": tools_needed,
        "vamp_intent": vamp_intent,
    }







import logging

from cstgenai_common_entities.model.constants import LAST
from cstgenai_common_entities.model.prompt import Prompt
from langchain_core.messages import AIMessage

from cstgenai_rag.model.rag.state import GraphState
from cstgenai_rag.support.db import get_repository_manager
from cstgenai_rag.llm.llm_client import get_llm

logger = logging.getLogger(__name__)

llm = get_llm(stream=False)


def synthesise_response(state: GraphState) -> GraphState:
    """
    GENERATE node: synthesise an answer based on previous stage data
    (tools, RAG, etc.) using the configured prompt templates.

    IMPORTANT:
    - We do NOT end the workflow here.
    - `next_step` is set to None so that conditional routing can decide
      whether to go to VAMP_RETRIEVE or END.
    """

    last_stage_data = state.get("last_stage_data")
    logger.info("--GENERATE: synthesise based on tool / vector store response--")

    messages = state["messages"]
    prompt_key = state.get("generate_prompt_key")

    repo_manager = get_repository_manager()
    prompt_repo = repo_manager.prompt_repo

    prompt: Prompt | None = prompt_repo.find_one(filter_query={"key": prompt_key})

    if prompt:
        prompt_message = prompt.content
        logger.debug(f"Using template prompt for key={prompt_key}")
    else:
        logger.warning(f"No prompt template found for key={prompt_key}")
        prompt_message = f"System Prompt. Context messages: {messages}"

    # Invoke model
    response = llm.invoke(prompt_message)

    return {
        "messages": [AIMessage(content=response.content)],
        # CRITICAL: allow workflow to route to VAMP or END
        "next_step": None,
        "last_stage_data": last_stage_data,
    }








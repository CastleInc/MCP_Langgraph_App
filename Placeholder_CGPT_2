def synthesise_response(state: GraphState) -> GraphState:
    logger.info("=== GENERATE NODE ===")

    llm = get_llm(stream=False)
    messages = state.get("messages", [])

    tool_answer = (state.get("tool_answer") or "").strip()
    general_question = (state.get("general_question") or "").strip()

    logger.info(f"[GENERATE] tool_answer={tool_answer}")
    logger.info(f"[GENERATE] general_question={general_question}")

    # -----------------------------------------------------------
    # CASE 1: Tool + General → stitch both
    # -----------------------------------------------------------
    if tool_answer and general_question:
        logger.info("Case: Tool + General → Stitch in GENERATE")

        stitched = f"""
Tool Result:
{tool_answer}

General Question:
{general_question}

Provide a combined, well-structured answer containing BOTH results.
""".strip()

        response = llm.invoke(stitched)

        # DO NOT END HERE — go to AGGREGATE
        return {
            "messages": [AIMessage(content=response.content)],
            "next_step": AGGREGATE,
            "last_stage_data": state.get("last_stage_data"),
            "final_generate_output": response.content
        }

    # -----------------------------------------------------------
    # CASE 2: Only general
    # -----------------------------------------------------------
    if general_question and not tool_answer:
        logger.info("Case: Only General Question → Normal generate")

        response = llm.invoke(general_question)

        return {
            "messages": [AIMessage(content=response.content)],
            "next_step": AGGREGATE,
            "last_stage_data": state.get("last_stage_data"),
            "final_generate_output": response.content
        }

    # -----------------------------------------------------------
    # CASE 3: Only tool answer (templated or raw)
    # -----------------------------------------------------------
    if tool_answer and not general_question:
        logger.info("Case: Tool Only → Forward to AGGREGATE")

        return {
            "messages": [AIMessage(content=tool_answer)],
            "next_step": AGGREGATE,
            "last_stage_data": state.get("last_stage_data"),
            "final_generate_output": tool_answer
        }

    # -----------------------------------------------------------
    # CASE 4: Fallback → original RAG path
    # -----------------------------------------------------------
    logger.info("Case: fallback RAG flow → GENERATE then AGGREGATE")

    prompt_key = state.get("generate_prompt_key")
    repo = get_repository_manager().prompt_repo
    prompt_obj = repo.find_one(filter_query={"key": prompt_key})

    prompt = f"""{prompt_obj.content if prompt_obj else "System Prompt"}
Context: {messages}
"""

    response = llm.invoke(prompt)

    return {
        "messages": [AIMessage(content=response.content)],
        "next_step": AGGREGATE,
        "last_stage_data": state.get("last_stage_data"),
        "final_generate_output": response.content
    }



def aggregate_node(state: GraphState) -> GraphState:
    logger.info("=== AGGREGATE NODE ===")

    msgs = list(state.get("messages", []))
    generated_output = (state.get("final_generate_output") or "").strip()
    templated_output = (state.get("templated_output") or "").strip()

    logger.info(f"[AGG] generated_output={generated_output}")
    logger.info(f"[AGG] templated_output={templated_output}")

    final_text = ""

    # Case 1: Both templated and generated present
    if templated_output and generated_output:
        final_text = f"{templated_output}\n\n{generated_output}"

    # Case 2: Only generated present
    elif generated_output:
        final_text = generated_output

    # Case 3: Only templated present
    elif templated_output:
        final_text = templated_output

    else:
        logger.warning("[AGG] No templated or generated output found.")
        final_text = "Unable to generate answer."

    # Final answer message
    state["messages"] = [AIMessage(content=final_text)]
    state["next_step"] = END
    state["final_answer"] = final_text

    return state







def route_after_tool_agent(state: GraphState) -> str:
    """
    Decide next step after the TOOL_AGENT node.
    Checks:
        1. Whether a tool was invoked
        2. Whether template exists
        3. Whether general question exists
    """

    messages = state.get("messages", [])
    last_message = messages[-1] if messages else None

    # -----------------------------------------
    # CASE 1: Tool was called by the agent
    # -----------------------------------------
    if last_message and hasattr(last_message, "tool_calls"):
        logger.info("route_after_tool_agent: Tool calls detected in last_message")

        # ALWAYS go to EXECUTE_TOOLS node
        return ACT

    # -----------------------------------------
    # CASE 2: No tool call
    # LLM responded with textual "let me check" etc.
    # → Then route to RETRIEVE (existing behaviour)
    # -----------------------------------------
    if last_message and hasattr(last_message, "content"):
        response_content = last_message.content.lower()

        trigger_phrases = [
            "need more information",
            "would need to check",
            "let me search",
            "i’ll need to"
        ]

        if any(tp in response_content for tp in trigger_phrases):
            logger.info("route_after_tool_agent: No tool call but LLM suggests RETRIEVE")
            return RETRIEVE

    # -----------------------------------------
    # DEFAULT FALLBACK — No tool calls, no signals
    # -----------------------------------------
    logger.info("route_after_tool_agent: Defaulting to RETRIEVE")
    return RETRIEVE
